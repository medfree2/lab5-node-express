{
  "openapi": "3.0.0",
  "info": {
    "title": "API Produits — LAB 5",
    "version": "1.0.0",
    "description": "API REST CRUD Node.js / Express — Mohammed Noureddine"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Serveur local"
    }
  ],
  "tags": [
    {
      "name": "Products",
      "description": "Gestion des produits en mémoire"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api-docs.json": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Obtenir un produit par ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          },
          "404": {
            "description": "Produit non trouvé"
          }
        }
      },
      "put": {
        "tags": [
          "Products"
        ],
        "summary": "Remplacer un produit",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          },
          "404": {
            "description": "Produit non trouvé"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Products"
        ],
        "summary": "Modifier partiellement un produit",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          },
          "404": {
            "description": "Produit non trouvé"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductPatch"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "summary": "Supprimer un produit",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          },
          "404": {
            "description": "Produit non trouvé"
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Lister tous les produits",
        "description": "",
        "responses": {
          "200": {
            "description": "Succès"
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Créer un produit",
        "description": "",
        "responses": {
          "201": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductInput": {
        "type": "object",
        "required": [
          "name",
          "price",
          "stock"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Écran 24 pouces"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 199.99
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "example": 10
          }
        }
      },
      "ProductPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Écran 24 pouces"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 199.99
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "example": 10
          }
        }
      },
      "Product": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProductInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              }
            }
          }
        ]
      }
    }
  }
}
